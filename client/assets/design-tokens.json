        "hex": "#f0a489"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 12,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 48,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 96,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "none": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    }
  },
  "typography": {
    "display-xl": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Newsreader",
        "fontSize": {
          "value": 6.25,
          "unit": "rem"
        },
        "fontWeight": 500,
        "lineHeight": 0.93,
        "letterSpacing": {
          "value": -0.34375,
          "unit": "rem"
        }
      }
    },
    "display-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Newsreader",
        "fontSize": {
          "value": 4.375,
          "unit": "rem"
        },
        "fontWeight": 500,
        "lineHeight": 0.98,
        "letterSpacing": {
          "value": -0.196875,
          "unit": "rem"
        }
      }
    },
    "heading-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Newsreader",
        "fontSize": {
          "value": 1.9375,
          "unit": "rem"
        },
        "fontWeight": 500,
        "lineHeight": 1.05,
        "letterSpacing": {
          "value": -0.0678125,
          "unit": "rem"
        }
      }
    },
    "body-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Manrope",
        "fontSize": {
          "value": 1.125,
          "unit": "rem"
        },
        "fontWeight": 400,
        "lineHeight": 1.55,
        "letterSpacing": {
          "value": 0,
          "unit": "rem"
        }
      }
    },
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Manrope",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400,
        "lineHeight": 1.55,
        "letterSpacing": {
          "value": 0,
          "unit": "rem"
        }
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "DM Mono",
        "fontSize": {
          "value": 0.6875,
          "unit": "rem"
        },
        "fontWeight": 500,
        "lineHeight": 1.3,
        "letterSpacing": {
          "value": 0.06875,
          "unit": "rem"
        }
      }
    }
