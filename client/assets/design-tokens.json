        "hex": "#465148"
      }
    },
    "muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.388,
          0.435,
          0.392
        ],
        "hex": "#636f64"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.776,
