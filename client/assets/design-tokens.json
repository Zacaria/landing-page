{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Monumental editorial serif, technical metadata, fine rules and restrained chartreuse accents.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.137, 0.137, 0.122],
        "hex": "#23231f"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.408, 0.404, 0.373],
        "hex": "#68675f"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.831, 1, 0.31],
        "hex": "#d4ff4f"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.961, 0.953, 0.929],
        "hex": "#f5f3ed"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.933, 0.925, 0.898],
        "hex": "#eeece5"
      }
    },
    "dark-background": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.043, 0.043, 0.047],
        "hex": "#0b0b0c"
      }
    },
    "dark-text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.925, 0.91, 0.882],
        "hex": "#ece8e1"
      }
    },
    "dark-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.635, 0.62, 0.592],
        "hex": "#a29e97"
      }
    },
    "dark-link": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.831, 1, 0.31],
        "hex": "#d4ff4f"
      }
    },
    "dark-surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [0.071, 0.071, 0.078],
        "hex": "#121214"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "none": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "search": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    }
  },
  "typography": {
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Instrument Serif",
        "fontSize": {
          "value": 7.5,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": -0.02,
          "unit": "em"
        }
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Geist",
        "fontSize": {
          "value": 1.0625,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "article": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Geist",
        "fontSize": {
          "value": 1.0625,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    }
  }
}
