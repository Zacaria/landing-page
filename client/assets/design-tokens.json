{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "A compact monospace personal publication with explicit appearance controls.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0,
          0
        ],
        "hex": "#000000"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.392,
          0.392,
          0.392
        ],
        "hex": "#646464"
      }
    },
    "accent": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0,
          0,
          0.933
        ],
        "hex": "#0000ee"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.957,
          0.957,
          0.945
        ],
        "hex": "#f4f4f1"
      }
    },
    "dark-background": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.063,
          0.067,
          0.075
        ],
        "hex": "#101113"
      }
    },
    "dark-text": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.906,
          0.914,
          0.929
        ],
        "hex": "#e7e9ed"
      }
    },
    "dark-muted": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.643,
          0.663,
          0.698
        ],
        "hex": "#a4a9b2"
      }
    },
    "dark-link": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.549,
          0.655,
          1
        ],
        "hex": "#8ca7ff"
      }
    },
    "dark-surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.11,
          0.118,
          0.137
        ],
        "hex": "#1c1e23"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "sm": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 32,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "none": {
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "search": {
      "$value": {
        "value": 6,
        "unit": "px"
      }
    }
  },
  "typography": {
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Geist Mono",
        "fontSize": {
          "value": 1.25,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": 0.025,
          "unit": "em"
        }
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Geist Mono",
        "fontSize": {
          "value": 0.875,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    },
    "article": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Geist Mono",
        "fontSize": {
          "value": 0.9375,
          "unit": "rem"
        },
        "fontWeight": 400,
        "letterSpacing": {
          "value": 0,
          "unit": "em"
        }
      }
    }
  }
}
