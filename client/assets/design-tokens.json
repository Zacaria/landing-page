      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.945,
          0.933,
          0.902
        ],
        "hex": "#f1eee6"
      }
    },
    "surface": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.984,
          0.98,
          0.965
        ],
        "hex": "#fbfaf6"
      }
    },
    "on-tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "hex": "#ffffff"
      }
    },
    "accent-light": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.722,
          0.843,
          0.792
